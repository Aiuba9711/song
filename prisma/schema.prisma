// Emprego Fácil MZ — esquema da base de dados.
// Documentação: DATABASE.md
//
// Convenções:
// - IDs: cuid (strings, não sequenciais → não expõem volume de dados).
// - Dinheiro: inteiros em unidades mínimas (centavos) + código de moeda ISO 4217.
// - Datas em UTC.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identidade
// ─────────────────────────────────────────────────────────────

enum Role {
  USER
  EDITOR
  ADMIN
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique // sempre em minúsculas
  passwordHash        String
  name                String
  phone               String?
  role                Role      @default(USER)
  locale              String    @default("pt-MZ")
  emailVerifiedAt     DateTime?
  termsAcceptedAt     DateTime
  marketingConsent    Boolean   @default(false)
  isActive            Boolean   @default(true)
  currentCvTemplateId String? // modelo escolhido para o CV em preparação
  aiConsentAt         DateTime? // consentimento para enviar texto a um provedor de IA externo (null = sem consentimento)
  imageAiConsentAt    DateTime? // consentimento para enviar FOTOGRAFIAS a um serviço externo de edição (null = sem consentimento)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  currentCvTemplate CVTemplate?          @relation("CurrentCvTemplate", fields: [currentCvTemplateId], references: [id], onDelete: SetNull)
  profile           Profile?
  sessions          Session[]
  passwordResets    PasswordResetToken[]
  cvs               CV[]
  coverLetters      CoverLetter[]
  photos            ProfessionalPhoto[]
  documents         Document[]
  orders            Order[]
  downloads         Download[]
  affiliate         Affiliate?
  blogPosts         BlogPost[]
  auditLogs         AuditLog[]
  paymentReviews    Payment[]            @relation("PaymentReviews")

  @@index([createdAt])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  headline  String? // profissão / título
  location  String?
  country   String   @default("MZ") // ISO 3166-1 alpha-2
  currency  String   @default("MZN") // moeda preferida
  whatsapp  String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // SHA-256 do token do cookie; o token em claro nunca é guardado
  userId     String
  expiresAt  DateTime
  userAgent  String?
  ipHash     String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Currículos
// ─────────────────────────────────────────────────────────────

enum TemplateCategory {
  GERAL
  PRIMEIRO_EMPREGO
  RECEM_FORMADO
  ADMINISTRATIVO
  CONTABILIDADE
  RECURSOS_HUMANOS
  SAUDE
  ENFERMAGEM
  OPTOMETRIA
  EDUCACAO
  ENGENHARIA
  INFORMATICA
  MARKETING
  VENDAS
  VENDAS_MARKETING // legado (antes de separar Marketing e Vendas)
  ATENDIMENTO_CLIENTE
  GESTAO
  FINANCAS
  CONSTRUCAO
  LOGISTICA
  HOTELARIA
  MOTORISTA
  TECNICO_PROFISSIONAL
  EXECUTIVO
}

// Família visual de base (compatibilidade). O aspeto real de cada modelo é definido
// pelo campo `design` (TemplateDesign — src/cv/design.ts), interpretado por um único
// motor que gera a pré-visualização HTML, o PDF e o DOCX.
enum CvLayout {
  CLASSICO
  MODERNO
  EXECUTIVO
}

model CVTemplate {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String
  category        TemplateCategory @default(GERAL)
  style           String           @default("Profissional") // etiqueta: Minimal, Executive, Timeline…
  layout          CvLayout
  design          Json? // TemplateDesign; null = predefinição da família `layout`
  accentColor     String           @default("#1d4ed8") // hex
  isAtsFriendly   Boolean          @default(false)
  priceMinor      Int? // preço deste modelo; null = valor padrão em PaymentSettings
  previewImageUrl String? // imagem de pré-visualização (gerada ou carregada no admin)
  previewImageKey String? // chave no storage quando carregada no admin
  isActive        Boolean          @default(true)
  isPremium       Boolean          @default(false)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  cvs          CV[]
  currentUsers User[] @relation("CurrentCvTemplate")

  @@index([isActive, sortOrder])
}

model CV {
  id                  String    @id @default(cuid())
  userId              String
  templateId          String?
  title               String // nome interno, ex.: "CV — Contabilista"
  locale              String    @default("pt-MZ")
  // Dados pessoais
  fullName            String    @default("")
  jobTitle            String    @default("")
  email               String    @default("")
  phone               String    @default("")
  location            String    @default("")
  nationality         String?
  birthDate           String? // texto livre opcional (não obrigatório em candidaturas)
  linkedin            String?
  website             String?
  photoKey            String? // chave no StorageProvider (privado) — imagem já comprimida, sem EXIF
  showPhoto           Boolean   @default(false)
  photoZoom           Float     @default(1) // enquadramento: 1–3
  photoOffsetX        Float     @default(0) // -1 (esquerda) … 1 (direita)
  photoOffsetY        Float     @default(0) // -1 (cima) … 1 (baixo)
  photoPosition       String? // null = posição do modelo; "left" | "right" | "center"
  purchasedAt         DateTime? // CV comprado (download final libertado; modelo fixo)
  // Conteúdo
  summary             String    @default("")
  objective           String    @default("") // objetivo profissional (opcional)
  professionalPhotoId String? // foto profissional usada (a imagem do CV é uma cópia própria em photoKey)
  referencesOnRequest Boolean   @default(false)
  hiddenSections      String[]  @default([]) // secções opcionais ocultas
  currentStep         Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  professionalPhoto ProfessionalPhoto? @relation(fields: [professionalPhotoId], references: [id], onDelete: SetNull)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template          CVTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  experiences       CVExperience[]
  educations        CVEducation[]
  skills            CVSkill[]
  languages         CVLanguage[]
  courses           CVCourse[]
  references        CVReference[]
  customSections    CVCustomSection[]
  downloads         Download[]
  orderItems        OrderItem[]

  @@index([userId, updatedAt])
}

model CVExperience {
  id          String  @id @default(cuid())
  cvId        String
  position    String
  employer    String
  location    String  @default("")
  startDate   String  @default("") // texto livre: "Mar 2021", "2019"
  endDate     String  @default("")
  isCurrent   Boolean @default(false)
  description String  @default("")
  sortOrder   Int     @default(0)

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model CVEducation {
  id          String  @id @default(cuid())
  cvId        String
  degree      String
  institution String
  location    String  @default("")
  startDate   String  @default("")
  endDate     String  @default("")
  isCurrent   Boolean @default(false)
  description String  @default("")
  sortOrder   Int     @default(0)

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model CVSkill {
  id        String  @id @default(cuid())
  cvId      String
  name      String
  level     String? // opcional: Básico / Intermédio / Avançado
  sortOrder Int     @default(0)

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model CVLanguage {
  id        String @id @default(cuid())
  cvId      String
  name      String
  level     String // Nativo / Fluente / Avançado / Intermédio / Básico
  sortOrder Int    @default(0)

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

enum CourseKind {
  COURSE
  CERTIFICATION
}

model CVCourse {
  id          String     @id @default(cuid())
  cvId        String
  kind        CourseKind @default(COURSE)
  name        String
  institution String     @default("")
  year        String     @default("")
  sortOrder   Int        @default(0)

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model CVReference {
  id        String @id @default(cuid())
  cvId      String
  name      String
  position  String @default("")
  company   String @default("")
  phone     String @default("")
  email     String @default("")
  sortOrder Int    @default(0)

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model CVCustomSection {
  id        String @id @default(cuid())
  cvId      String
  title     String
  content   String
  sortOrder Int    @default(0)

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

// ─────────────────────────────────────────────────────────────
// Cartas e documentos (Fase 2)
// ─────────────────────────────────────────────────────────────

enum CoverLetterType {
  CANDIDATURA
  MOTIVACAO
}

model CoverLetter {
  id            String          @id @default(cuid())
  userId        String
  type          CoverLetterType
  title         String
  senderName    String          @default("")
  senderContact String          @default("")
  recipientName String          @default("")
  company       String          @default("")
  position      String          @default("")
  experience    String          @default("")
  education     String          @default("")
  skills        String          @default("")
  motivation    String          @default("")
  city          String          @default("") // local que aparece na data (ex.: Maputo)
  subject       String          @default("") // assunto da carta
  body          String          @default("") // texto final editado pelo utilizador
  purchasedAt   DateTime? // compra confirmada (quando a carta é paga)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  downloads  Download[]

  @@index([userId, updatedAt])
}

enum DocumentKind {
  CV_PDF
  CV_DOCX
  LETTER_PDF
  LETTER_DOCX
  UPLOAD
}

// Ficheiros guardados em nome do utilizador (ex.: exportações arquivadas, uploads).
model Document {
  id         String       @id @default(cuid())
  userId     String
  kind       DocumentKind
  title      String
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Loja
// ─────────────────────────────────────────────────────────────

enum ProductType {
  KIT
  TEMPLATE_PACK
  TOOL
  SUBSCRIPTION
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id                  String        @id @default(cuid())
  slug                String        @unique
  name                String
  tier                String? // etiqueta comercial: BASIC / PROFISSIONAL / PREMIUM
  shortDescription    String
  description         String // texto simples com parágrafos
  type                ProductType   @default(KIT)
  status              ProductStatus @default(DRAFT)
  priceMinor          Int // centavos; 0 = gratuito
  compareAtPriceMinor Int?
  currency            String        @default("MZN")
  features            String[]      @default([]) // "o que está incluído"
  faq                 Json? // [{ q, a }]
  imageUrl            String?
  isFeatured          Boolean       @default(false)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  files      ProductFile[]
  orderItems OrderItem[]
  coupons    Coupon[]      @relation("CouponProducts")

  @@index([status, sortOrder])
}

model ProductFile {
  id         String   @id @default(cuid())
  productId  String
  name       String // nome apresentado
  fileName   String // nome no download
  storageKey String
  mimeType   String
  sizeBytes  Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloads Download[]

  @@index([productId])
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT // pedido criado; o cliente ainda não enviou os dados do pagamento
  PENDING_VERIFICATION // o cliente informou a transação; aguarda verificação do administrador
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id            String      @id @default(cuid())
  number        String      @unique // ex.: EF-20260926-7K3P
  userId        String?
  customerName  String
  customerEmail String
  customerPhone String?
  status        OrderStatus @default(PENDING)
  subtotalMinor Int
  discountMinor Int         @default(0)
  totalMinor    Int
  currency      String      @default("MZN")
  couponId      String?
  affiliateId   String?
  paidAt        DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon    Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  affiliate Affiliate?  @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([customerEmail])
}

enum OrderItemKind {
  PRODUCT // kit/produto digital
  CV_UNLOCK // desbloqueio do download de um CV do utilizador
  LETTER_UNLOCK // desbloqueio do download de uma carta do utilizador
  PHOTO_UNLOCK // desbloqueio de uma foto profissional (download e uso no CV)
  CV_PHOTO_BUNDLE // pacote CV + Foto profissional (desbloqueia os dois)
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  kind           OrderItemKind @default(PRODUCT)
  productId      String?
  cvId           String?
  letterId       String?
  photoId        String?
  productName    String // cópia no momento da compra
  unitPriceMinor Int
  quantity       Int           @default(1)

  order   Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  cv      CV?                @relation(fields: [cvId], references: [id], onDelete: SetNull)
  letter  CoverLetter?       @relation(fields: [letterId], references: [id], onDelete: SetNull)
  photo   ProfessionalPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([cvId])
  @@index([letterId])
  @@index([photoId])
}

enum PaymentProviderId {
  FREE
  MOCK
  MPESA
  EMOLA
  MKESH
  CARD
}

enum PaymentMode {
  MANUAL // transferência para número de carteira móvel, verificada por um administrador
  API // integração oficial com o fornecedor (futuro)
}

enum PaymentStatus {
  PENDING // aguarda que o cliente pague e informe a transação
  PENDING_VERIFICATION // cliente informou a transação; aguarda o administrador
  RESUBMISSION_REQUESTED // administrador pediu novo comprovativo
  SUCCEEDED
  REJECTED // administrador rejeitou (ex.: transação não encontrada)
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id                String            @id @default(cuid())
  orderId           String
  provider          PaymentProviderId
  mode              PaymentMode       @default(API)
  status            PaymentStatus     @default(PENDING)
  amountMinor       Int
  currency          String            @default("MZN")
  providerReference String? // referência devolvida por um gateway oficial (modo API)
  failureReason     String?
  metadata          Json? // resposta do gateway SEM segredos
  // ── Pagamento manual ─────────────────────────────────────
  payeeNumber       String? // número de destino apresentado ao cliente (cópia para auditoria)
  payerName         String? // nome do titular informado pelo cliente
  payerPhone        String? // número usado para pagar, informado pelo cliente
  transactionId     String? // código da transação (SMS do operador), informado pelo cliente
  reportedPaidAt    DateTime? // data/hora aproximada informada pelo cliente
  proofKey          String? // comprovativo (armazenamento privado)
  proofMime         String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewNote        String? // motivo da rejeição / pedido de novo comprovativo
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([status, submittedAt])
  @@index([provider, transactionId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique // maiúsculas, ex.: EMPREGOMZ10
  description    String?
  percentOff     Int? // 1–100
  amountOffMinor Int?
  currency       String    @default("MZN")
  validFrom      DateTime?
  validUntil     DateTime?
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products Product[] @relation("CouponProducts") // vazio = todos os produtos
  orders   Order[]
}

enum DownloadKind {
  CV_PDF
  CV_DOCX
  LETTER_PDF
  LETTER_DOCX
  PHOTO_JPG
  PHOTO_PNG
  PRODUCT_FILE
}

// Registo de downloads (histórico do utilizador + métricas).
model Download {
  id            String       @id @default(cuid())
  userId        String?
  kind          DownloadKind
  cvId          String?
  productFileId String?
  letterId      String?
  photoId       String?
  label         String // nome apresentado no histórico
  createdAt     DateTime     @default(now())

  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv          CV?                @relation(fields: [cvId], references: [id], onDelete: SetNull)
  productFile ProductFile?       @relation(fields: [productFileId], references: [id], onDelete: SetNull)
  letter      CoverLetter?       @relation(fields: [letterId], references: [id], onDelete: SetNull)
  photo       ProfessionalPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Crescimento (Fase 3)
// ─────────────────────────────────────────────────────────────

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Affiliate {
  id                String          @id @default(cuid())
  userId            String?         @unique
  code              String          @unique // ?ref=code
  commissionPercent Int             @default(10)
  clicks            Int             @default(0)
  balanceMinor      Int             @default(0)
  currency          String          @default("MZN")
  status            AffiliateStatus @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]
}

// Contactos recolhidos com consentimento (ex.: modelo gratuito).
model Lead {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  name      String?
  source    String // ex.: "modelo-gratuito"
  consentAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Conteúdo e configuração
// ─────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String
  content        String // Markdown
  coverImageUrl  String?
  status         PostStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  authorId       String?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

// Linha única (id = "default"), editável no painel admin.
model SiteSettings {
  id                   String   @id @default("default")
  siteName             String   @default("Emprego Fácil MZ")
  whatsappNumber       String? // formato internacional sem "+", ex.: 258840000000
  whatsappMessage      String?
  // Modelos de mensagem WhatsApp dos utilizadores: indicativo usado quando o número
  // não o tem, e se o botão «Abrir WhatsApp» está disponível.
  whatsappCountryCode  String   @default("258")
  whatsappLinksEnabled Boolean  @default(true)
  contactEmail         String?
  contactPhone         String?
  facebookUrl          String?
  instagramUrl         String?
  tiktokUrl            String?
  linkedinUrl          String?
  supportHours         String?
  updatedAt            DateTime @updatedAt
}

// Configuração central de pagamentos (linha única "default"), editável em
// Admin > Definições > Pagamentos. Os números de pagamento NÃO estão no código.
model PaymentSettings {
  id                    String    @id @default("default")
  mpesaEnabled          Boolean   @default(false)
  mpesaNumber           String? // número nacional, ex.: 84XXXXXXX
  emolaEnabled          Boolean   @default(false)
  emolaNumber           String?
  mkeshEnabled          Boolean   @default(false)
  mkeshNumber           String?
  accountHolderName     String? // nome do titular apresentado ao cliente (opcional)
  instructions          String    @default("")
  currency              String    @default("MZN")
  defaultPriceMinor     Int       @default(19900) // preço do desbloqueio de download de um CV
  cvPaywallEnabled      Boolean   @default(true) // exigir pagamento para descarregar CVs (cada CV profissional)
  letterPriceMinor      Int       @default(0) // preço do download (PDF/DOCX) de uma carta; 0 = gratuito
  // Foto profissional: 0 = gratuita. Pacote CV + Foto: null = pacote desativado.
  photoPriceMinor       Int       @default(0)
  photoPromoPriceMinor  Int? // preço promocional (opcional)
  photoPromoEndsAt      DateTime? // fim da promoção
  photoBundlePriceMinor Int?
  cardEnabled           Boolean   @default(false) // só pode ser ativado com um gateway oficial configurado
  updatedAt             DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // ex.: "auth.login", "product.update"
  entityType String?
  entityId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([entityType, entityId])
}

// Contadores de rate limiting (janela fixa). Partilhados entre instâncias serverless.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ─── Foto Profissional ─────────────────────────────────────
// As fotografias são dados pessoais: guardadas em armazenamento PRIVADO, servidas só ao dono,
// nunca usadas para treinar modelos. Ver PHOTO_MODULE.md.

enum PhotoFormat {
  PASSE // proporção 7:9 (tipo passe)
  CV // 4:5 (retrato profissional)
  QUADRADA // 1:1 (perfil)
  PERSONALIZADA
}

model ProfessionalPhoto {
  id           String      @id @default(cuid())
  userId       String
  originalKey  String // original normalizada (sem metadados EXIF/GPS)
  resultKey    String? // resultado final (PNG) guardado pelo editor
  thumbKey     String? // miniatura (JPEG) para a galeria
  format       PhotoFormat @default(CV)
  width        Int?
  height       Int?
  settings     Json? // estado do editor, para voltar a editar
  backgroundId String?
  outfitId     String?
  styleLabel   String      @default("") // descrição do resultado (ex.: «Fundo branco · Blazer azul-marinho»)
  purchasedAt  DateTime? // quando a foto é paga
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  background PhotoBackground? @relation(fields: [backgroundId], references: [id], onDelete: SetNull)
  outfit     PhotoOutfit?     @relation(fields: [outfitId], references: [id], onDelete: SetNull)
  cvs        CV[]
  orderItems OrderItem[]
  downloads  Download[]

  @@index([userId, createdAt])
}

enum BackgroundCategory {
  NEUTRO
  CORPORATIVO
  GRADIENTE
}

enum BackgroundKind {
  SOLID // cor única (color1)
  GRADIENT // gradiente vertical color1 → color2
  PATTERN // cenário desfocado desenhado pela aplicação (pattern)
  IMAGE // imagem carregada no admin (imageKey)
}

model PhotoBackground {
  id        String              @id @default(cuid())
  name      String
  category  BackgroundCategory
  kind      BackgroundKind
  color1    String              @default("#ffffff")
  color2    String?
  pattern   String? // "office" | "wall" | "studio"
  imageKey  String?
  /**
   * Adequado para foto tipo passe (fundos lisos e claros)
   */
  passport  Boolean             @default(false)
  isActive  Boolean             @default(true)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  photos    ProfessionalPhoto[]

  @@index([isActive, sortOrder])
}

enum OutfitGender {
  MASCULINO
  FEMININO
}

enum OutfitGarment {
  BLAZER // blazer/casaco com camisa ou blusa
  FATO // fato completo
  CAMISA // só camisa
  BLUSA // só blusa
}

model PhotoOutfit {
  id          String              @id @default(cuid())
  name        String
  gender      OutfitGender
  garment     OutfitGarment
  jacketColor String? // null = sem casaco
  shirtColor  String
  tieColor    String? // gravata sugerida (o utilizador pode tirar/trocar)
  /**
   * Estilos: CORPORATIVO, EXECUTIVO, PRIMEIRO_EMPREGO, ENTREVISTA, ACADEMICO
   */
  tags        String[]            @default([])
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  photos      ProfessionalPhoto[]

  @@index([isActive, sortOrder])
}
