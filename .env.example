# ─────────────────────────────────────────────────────────────
# Emprego Fácil MZ — variáveis de ambiente
# Copiar para .env (desenvolvimento) e configurar no fornecedor de hosting (produção).
# NUNCA commitar valores reais.
# ─────────────────────────────────────────────────────────────

# URL pública da aplicação (sem barra final). Usada em links de email, sitemap, Open Graph.
APP_URL="http://localhost:3000"

# PostgreSQL (ex.: Neon, Supabase, Railway). Em produção usar sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/emprego_dev?schema=public"

# Segredo da aplicação (mín. 32 caracteres aleatórios). Usado para hash de IPs nos logs
# e para assinar links de download temporários.
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET="substituir-por-um-segredo-longo-e-aleatorio"

# ── Armazenamento de ficheiros (kits, fotos de CV) ───────────────
# local = disco (apenas desenvolvimento / servidor com disco persistente)
# s3    = qualquer serviço compatível com S3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""             # ex.: https://<account>.r2.cloudflarestorage.com (vazio para AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Email ────────────────────────────────────────────────────────
# console = escreve os emails no log do servidor (desenvolvimento)
# resend  = API HTTP da Resend (https://resend.com) — requer domínio verificado
EMAIL_DRIVER="console"
EMAIL_FROM="Emprego Fácil MZ <nao-responder@empregofacilmz.com>"
RESEND_API_KEY=""

# ── Assistente de IA (opcional) ──────────────────────────────────
# Sem configuração, o editor mostra «Assistente de IA temporariamente indisponível.» e o
# resto do CV funciona normalmente.
#   AI_PROVIDER="anthropic" → API oficial da Anthropic (https://docs.anthropic.com). Exige
#                             ANTHROPIC_API_KEY e AI_MODEL (ID do modelo, ver documentação
#                             do provedor). O utilizador dá consentimento antes do 1.º envio.
#   AI_PROVIDER="mock"      → demonstração/testes: regras locais, sem IA real, nada sai do servidor.
#   AI_PROVIDER=""          → desligado.
# A chave NUNCA vai para o código nem para o repositório.
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
AI_MODEL=""
AI_TIMEOUT_MS="45000"

# ── Foto Profissional ────────────────────────────────────────────
# Ambiente (separa DEV / STAGING / PRODUCTION; vazio = segue NODE_ENV).
APP_ENV=""
# Tamanho máximo de envio de fotografias, em MB (1–25; predefinição 10).
PHOTO_MAX_UPLOAD_MB="10"
# Serviços EXTERNOS de imagem — ainda NÃO existe nenhuma integração implementada.
# Deixar vazio: a remoção de fundo local (fundos lisos) e a roupa digital funcionam sem eles.
# Qualquer valor preenchido aparece como ERRO em Admin › Foto Profissional até existir
# uma integração implementada com a documentação oficial do fornecedor. Ver PHOTO_MODULE.md.
IMAGE_BG_PROVIDER=""
IMAGE_CLOTHING_PROVIDER=""

# Multiplicador dos limites de pedidos (rate limiting). Manter 1 em produção.
RATE_LIMIT_SCALE="1"

# ── Administrador inicial (usado APENAS por `npm run admin:create`) ──
# Remover estes valores do ambiente depois de criar a conta.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# ── Pagamentos manuais (M-Pesa / e-Mola / mKesh) ─────────────────
# Usados APENAS pelo seed para criar a configuração inicial. Depois, os números,
# instruções e métodos ativos gerem-se em Admin > Definições > Pagamentos.
SEED_MPESA_NUMBER=""
SEED_EMOLA_NUMBER=""
SEED_MKESH_NUMBER=""

# ── Integrações oficiais por API (M-Pesa, e-Mola, mKesh, cartão) ──
# AINDA NÃO IMPLEMENTADAS. Os nomes das variáveis serão definidos quando houver documentação
# oficial e contrato com cada operador (ver PAYMENTS.md). Não preencher nada aqui por agora.

# ── Fase 3: analytics (ainda não implementado; só com consentimento) ──
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# NEXT_PUBLIC_META_PIXEL_ID=""
